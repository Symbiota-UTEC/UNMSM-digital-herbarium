# Copy this file to deploy.env and edit it for the HPC host.
# This file is sourced by the helper scripts, so use shell assignment syntax.

INSTANCE_PREFIX=herbarium
DATA_DIR="$HOME/herbarium-data"
SIF_DIR="$REPO_ROOT/apptainer/images"
BACKEND_ENV_FILE="$REPO_ROOT/backend/config/.env"
DB_INIT_DIR="$REPO_ROOT/db/init"

# These override the backend dotenv database settings in all helpers.
# Quote passwords so shell characters remain literal.
DB_USERNAME=herbarium
DB_PASSWORD='replace-with-a-strong-password'
DB_DATABASE=herbarium

# Use the hostname users will enter in their browsers.
PUBLIC_HOSTNAME=localhost
PUBLIC_IP=127.0.0.1
HTTPS_PORT=8443

# Enable both IPv4 and IPv6 HTTPS listeners. Requires host and curl IPv6 support.
ENABLE_IPV6=false
