# backend/config/.env.sample
#
# Copiar a backend/config/.env. Es el único .env del backend (lo carga
# config/env.py). USERNAME/PASSWORD/DATABASE deben coincidir con el .env de
# la raíz del repo si además se usa docker compose (ver /.env.sample).

# --- Base de datos (Postgres) ---
USERNAME=postgres
PASSWORD=postgres
HOST=localhost
PORT=5432
DATABASE=herbarium

# --- Auth (JWT) ---
# Requerido: el backend no arranca sin SECRET_KEY.
# Generar uno: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Reverse geocoding for Peru: INEI polygons (default) or Nominatim ---
PERU_ADMIN_RESOLVER=inei

# --- CORS ---
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# --- SeaweedFS (almacenamiento de imágenes) ---
SEAWEEDFS_INTERNAL_URL=http://herbarium_seaweedfs:8888
SEAWEEDFS_PUBLIC_URL=http://localhost:8888

# --- Bootstrap: institución y admin por defecto (scripts/create_admin.py) ---
# Se crean/actualizan al arrancar si no existen. Los *_ID deben ser UUID.
INSTITUTION_ID=ae3fa7bc-6437-4ffb-8e33-ec8935295289
INSTITUTION_NAME=Universidad Nacional Mayor de San Marcos
INSTITUTION_WEBSITE=https://www.unmsm.edu.pe/
INSTITUTION_COUNTRY=Perú
INSTITUTION_CITY=Lima
INSTITUTION_ADDRESS=Av. Universitaria 1801, San Miguel, Lima, Perú
INSTITUTION_EMAIL=
INSTITUTION_PHONE=

ADMIN_ID=ae3fa7bc-6437-4ffb-8e33-ec8935295280
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
