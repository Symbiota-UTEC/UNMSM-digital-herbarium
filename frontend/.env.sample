# frontend/.env.sample
#
# Copiar a frontend/.env. Sólo hace falta para `npm run dev` fuera de Docker
# (make dev ya inyecta estos valores directamente al servicio frontend-dev).
# Vite sólo expone al cliente las variables VITE_* (ver src/config/env.ts).

VITE_API_URL=http://localhost:8000/api
VITE_CAMERA_BASE_URL=http://172.31.99.9:8000
VITE_APP_NAME=Digital Herbarium
