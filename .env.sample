# Copiar a .env.

# Sólo lo usa `docker compose` (make dev/prd)
# para resolver los ${...} de docker-compose.yaml

# Arrancan el contenedor de Postgres; deben coincidir con USERNAME/PASSWORD/
# DATABASE de backend/config/.env, o el backend no podrá autenticarse.
USERNAME=postgres
PASSWORD=postgres
DATABASE=herbarium

# Deploy (opcional, sólo afecta a los servicios backend/frontend)
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://216.144.234.244:3000
SEAWEEDFS_PUBLIC_URL=http://localhost:8888
VITE_API_URL=http://localhost:8000/api
VITE_CAMERA_BASE_URL=http://172.31.99.9:8000
