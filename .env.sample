# Copiar a .env.

# Lo usan Docker Compose y `make dev` / `make prd` para resolver variables.

# Arrancan el contenedor de Postgres; deben coincidir con USERNAME/PASSWORD/
# DATABASE de backend/config/.env, o el backend no podrá autenticarse.
USERNAME=postgres
PASSWORD=postgres
DATABASE=herbarium

# Origen del frontend que puede llamar al backend.
# Para production, reemplazar localhost por el origen exacto del frontend.
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Configuración usada por el frontend production (se compila en la imagen).
# Para production, reemplazar localhost por la IP o dominio del VPS.
VITE_API_URL=http://localhost:8000/api
VITE_CAMERA_BASE_URL=http://172.31.99.9:8000

# Base devuelta en el campo `publicUrl` por el API. SeaweedFS permanece interno;
# configúralo sólo si los clientes consumen URLs directas del Filer.
SEAWEEDFS_PUBLIC_URL=http://localhost:8888
